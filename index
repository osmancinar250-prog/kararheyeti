<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karar Destek Heyeti</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root { --bg-dark: #0f172a; --card-bg: #1e293b; --accent: #38bdf8; --accent-gold: #fbbf24; }
        body { background-color: var(--bg-dark); color: #f8fafc; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; min-height: 100vh; }
        .card-custom { background: var(--card-bg); border: 1px solid #334155; border-radius: 12px; }
        .person-card { cursor: pointer; transition: all 0.2s; border: 2px solid transparent; }
        .person-card:hover { transform: translateY(-3px); border-color: var(--accent); }
        .person-card.selected { border-color: var(--accent-gold); background: rgba(251, 191, 36, 0.05); }
        .btn-accent { background: var(--accent); color: #0f172a; font-weight: 600; }
        .btn-accent:hover { background: #7dd3fc; color: #0f172a; }
        .chat-bubble { background: #334155; border-radius: 12px; padding: 15px; margin-bottom: 15px; position: relative; }
        .chat-bubble::before { content: ''; position: absolute; left: -10px; top: 15px; border-width: 5px 10px 5px 0; border-style: solid; border-color: transparent #334155 transparent transparent; }
        .hidden { display: none !important; }
    </style>
</head>
<body class="py-4">
<div class="container" style="max-width: 900px;">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-warning mb-0"><i class="bi bi-diagram-3-fill me-2"></i>Karar Destek Heyeti</h2>
            <small class="text-secondary">Akıllı Karar Danışmanlık Sistemi</small>
        </div>
        <button class="btn btn-outline-light btn-sm" onclick="openSettings()"><i class="bi bi-gear-fill me-1"></i> API Ayarları</button>
    </div>

    <!-- Step 1: Heyet Seçimi -->
    <div id="step1" class="card-custom p-4 mb-4">
        <h4 class="mb-3 text-info"><i class="bi bi-people-fill me-2"></i>1. Danışman Heyetini Seçin (Max 4 Kişi)</h4>
        <div class="row g-3" id="peopleGrid"></div>
        <div class="mt-4 text-end">
            <button class="btn btn-accent px-4" onclick="goToStep2()">Devam Et <i class="bi bi-arrow-right"></i></button>
        </div>
    </div>

